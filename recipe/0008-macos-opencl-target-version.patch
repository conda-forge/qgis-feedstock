 using namespace Qt::StringLiterals;

-#ifdef Q_OS_MAC
-#define CL_HPP_MINIMUM_OPENCL_VERSION 120
-#define CL_HPP_TARGET_OPENCL_VERSION 120
-#define CL_TARGET_OPENCL_VERSION 120
-#else
+// Same OpenCL C++ API level on every platform. On macOS this only affects
+// which cl2.hpp/opencl.hpp symbols are declared at build time; QGIS still
+// loads Apple's system OpenCL.framework (capped at 1.2) at runtime (see
+// QgsOpenClUtils::init()) and only calls core OpenCL 1.x functionality
+// here. CL_HPP_MINIMUM_OPENCL_VERSION must stay unset (defaults to 200):
+// opencl.hpp guards some definitions with "< 120" but their call sites
+// with "< 200", so any value in between drops the definition while
+// keeping the call (e.g. detail::getContextPlatformVersion).
 #define CL_USE_DEPRECATED_OPENCL_1_1_APIS
 #define CL_HPP_TARGET_OPENCL_VERSION 200
 #define CL_TARGET_OPENCL_VERSION 200
-#endif

 #include "qgsconfig.h"

